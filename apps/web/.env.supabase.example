# Copy to .env.local for Supabase-backed local development. Put hosted values in Vercel settings.
DATA_BACKEND=supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Server-only secret key (or legacy service_role key). Never use NEXT_PUBLIC_ for this value.
SUPABASE_SECRET_KEY=REPLACE_WITH_SERVER_SECRET_KEY
SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_PUBLISHABLE_OR_ANON_KEY
SITE_URL=http://localhost:3000
ENABLE_DEV_SIGN_IN=false
WORKER_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# These adapters are fictional fixtures until Member 3 connects real providers.
AI_PROVIDER=fake
PLACES_PROVIDER=fake
FAKE_AI_DELAY_MS=0
