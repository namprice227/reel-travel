# Copy to apps/web/.env.local. Never commit real values.
# For Supabase, use .env.supabase.example instead. Production never permits the file backend.
DATA_BACKEND=file

# Dev file store and private uploads. Default: <repo>/.local/dev-data
# REEL_DATA_DIR=

# Dev sign-in (email only, no password) is on outside production.
# Only available outside production with DATA_BACKEND=file; always disabled with Supabase.
# ENABLE_DEV_SIGN_IN=false

# Optional local fake-demo retry endpoint secret. The dedicated worker does not use HTTP.
WORKER_SECRET=change-me-dev-secret

# Defaults stay offline. Real imports require Supabase plus npm run worker; use openai/google for matches.
AI_PROVIDER=fake
PLACES_PROVIDER=fake

# Simulated extraction delay so the UI shows queued/processing states.
FAKE_AI_DELAY_MS=1200

# Dedicated worker requires Supabase; see docs/operations/worker.md.
WORKER_INTERVAL_MS=15000

# Optional server-side product analytics webhook. Payloads contain only allowlisted event names and bounded metadata.
# Production endpoints must use HTTPS. Keep the write key server-side.
ANALYTICS_ENDPOINT=
ANALYTICS_WRITE_KEY=

# Manual audio sample only. Never commit real keys. Blank model/timeout values use defaults.
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=
OPENAI_EXTRACTION_MODEL=
## Blank provider: openai when AI_PROVIDER=openai, otherwise offline baseline.
ITINERARY_PROVIDER=
# Defaults to gpt-4.1-mini-2025-04-14. Independent from extraction; one 40s/8000-token attempt.
OPENAI_ITINERARY_MODEL=
OPENAI_TIMEOUT_MS=

# Server-side keys. Google Places is the real-import default; keep all keys server-side.
GOOGLE_PLACES_API_KEY=
# Fail-closed production gate. Set only after reviewing stored fields, retention, attribution and billing against current Google terms.
GOOGLE_PLACES_POLICY_REVIEWED=false
GOOGLE_AI_API_KEY=
ANTHROPIC_API_KEY=

# YouTube transcript runner uses GOOGLE_AI_API_KEY above. Blank overrides use defaults.
GEMINI_TRANSCRIPTION_MODEL=
GEMINI_TRANSCRIPTION_TIMEOUT_MS=

# Optional Google Places request timeout (milliseconds; blank = 60000).
GOOGLE_PLACES_TIMEOUT_MS=

# For real transcript imports: AI_PROVIDER=openai, PLACES_PROVIDER=google.
# PLACES_PROVIDER=none explicitly skips lookup; fake/fake stays an offline fixture demo.

# Optional PLACES_PROVIDER=openstreetmap. Nominatim: blank uses the public search endpoint, a local persistent cache and a 20-second timeout.
# One local worker only for the public endpoint; shared DB gate allows at most four requests/minute.
# Read docs/operations/openstreetmap.md before using the public service.
NOMINATIM_SEARCH_URL=
NOMINATIM_CACHE_DIR=
NOMINATIM_TIMEOUT_MS=

# Contextual itinerary discovery (web process only; enabled with real Google Places).
# Set false to keep generic meal/activity ideas without nearby lookups.
ITINERARY_NEARBY_ENABLED=true
# open-meteo or none. Public API is for non-commercial use; paid key selects customer host.
ITINERARY_WEATHER_PROVIDER=open-meteo
OPEN_METEO_API_KEY=
