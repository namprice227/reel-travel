{
  "name": "reel-travel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "npm run dev -w @reel/web",
    "build": "npm run build -w @reel/web",
    "start": "npm run start -w @reel/web",
    "worker": "npm run start -w @reel/worker",
    "seed": "tsx database/seeds/seed-dev.ts",
    "smoke": "tsx scripts/smoke-api.ts",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "vitest run --config vitest.database.config.ts",
    "measure:planner": "tsx scripts/measure-planner.ts",
    "docs:api": "tsx scripts/generate-api-docs.ts",
    "docs:api:check": "tsx scripts/generate-api-docs.ts --check",
    "validate": "python scripts/validate_workspace.py",
    "check": "npm run typecheck && npm run test && npm run docs:api:check && npm run validate",
    "extract:audio": "tsx scripts/extract-audio.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.0",
    "tsx": "^4.23.13",
    "typescript": "~5.9.3",
    "vitest": "^5.0.0"
  }
}
